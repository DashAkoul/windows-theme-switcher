{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windows Theme Switcher",
  "version": "1.0.0",
  "identifier": "com.themeswitcher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Windows Theme Switcher",
        "width": 940,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false,
        "shadow": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DashAkoul",
    "category": "Utility",
    "shortDescription": "Switch Windows Light/Dark theme with one click from the system tray.",
    "longDescription": "Windows Theme Switcher is a lightweight tray utility that lets you switch between fully customizable Light and Dark Windows themes with a single click on the tray icon. It changes Windows Mode, App Mode, transparency, accent color and wallpaper through official Windows registry and API surfaces - no Settings app, no admin rights required.",
    "copyright": "Copyright © 2026 DashAkoul",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCODdDNTgxRjYzRkNGRkYKUldUL3p6LzJnY1dINi9qNkhSSVFBdHdHbndQd2g0VWQ4djkvTENPb1BwWE9RTFpiaWFDZkg3dHMK",
      "endpoints": [
        "https://github.com/DashAkoul/windows-theme-switcher/releases/latest/download/latest.json"
      ]
    }
  }
}
